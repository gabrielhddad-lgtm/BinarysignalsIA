# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
MCP_SERVER_NAME=BinarySignalsIA
MCP_SERVER_VERSION=1.0.0

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Market Configuration
MCP_MARKET_URL=https://app.mcpmarket.com/medmetodovendas/mcp/binarysignalsia
MCP_MARKET_API_KEY=your_market_api_key

# Trading Configuration
TRADING_PAIR=EURUSD
TRADING_TIMEFRAME=15m
TRADING_MIN_SIGNAL_STRENGTH=0.7

# Logging
LOG_FILE=logs/binarysignalsia.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
